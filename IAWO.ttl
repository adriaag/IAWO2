cb:implementation-nonstandard_column_remover a tb:Implementation ;
    rdfs:label "Nonstandard column remover" ;
    tb:compatibleWith cb:Python ;
    tb:has_transformation """ 
    DELETE {

    ?subject ?predicate ?object .
    ?base dmop:hasColumn ?subject .
    
    }
    WHERE {
    ?base a dmop:TabularDataset .
    ?base dmop:hasColumn ?subject .
    VALUES ?subject { $$COLUMNS_TO_TRANSFORM$$ }
    OPTIONAL { ?subject <http://www.e-lico.eu/ontologies/dmo/DMOP/DMOP.owl#hasDataPrimitiveTypeColumn> ?insVal_1 . }
    ?subject <http://www.e-lico.eu/ontologies/dmo/DMOP/DMOP.owl#isFeature> true.
    }
    """ ;
    tb:implements cb:cleaning ;
    tb:specifiesInput cb:implementation-nonstandard_column_remover-InputSpec-isTabularDatasetShapeDatasetShape ;
    tb:specifiesOutput cb:implementation-nonstandard_column_remover-OutputSpec-isCategoricalOrNumericPropertyShapeFeatureShape .

