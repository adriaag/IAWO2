cb:noMissingValuesPropertyShape a sh:PropertyShape ;
    sh:datatype xsd:boolean ;
    sh:hasValue false ;
    sh:path dmop:containsNulls .

cb:ImputerModelModelShape a sh:NodeShape,
        tb:DataCharacteristic,
        tb:ModelTag ;
    sh:property [ a sh:PropertyShape ;
            sh:hasValue tb:ModelTag ;
            sh:path rdf:type ] ;
    sh:targetClass dmop:ImputerModel .

cb:StandardizedPropertyShapeFeatureShape a sh:NodeShape,
        tb:DataCharacteristic ;
    sh:or ( [ sh:property [ a sh:PropertyShape ;
                        sh:hasValue false ;
                        sh:path dmop:isFeature ] ] [ sh:property cb:StandardizedPropertyShape ] ) ;
